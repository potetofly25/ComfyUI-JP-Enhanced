# Copy this file to .env.dev and edit. (.env.dev is NOT committed)
# Used only by run_comfyui_dev.bat. .env is NOT read in dev mode.

# Dev uses its own port so it can run alongside the normal instance.
COMFYUI_PORT=8189

# Use separate folders so dev work does not mix with the normal output.
# COMFYUI_INPUT_DIR=
# COMFYUI_OUTPUT_DIR=

# Extra ComfyUI arguments (space separated; use / instead of \ in paths).
COMFYUI_EXTRA_ARGS=--verbose DEBUG
